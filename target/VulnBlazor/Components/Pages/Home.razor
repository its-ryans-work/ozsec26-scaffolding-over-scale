@page "/"

<PageTitle>ACorp</PageTitle>

<section class="mx-auto mt-24 max-w-5xl px-4 text-center sm:mt-32">
    <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600 dark:text-indigo-400">
        ACorp
    </p>
    <h1 class="mt-8 text-4xl font-bold tracking-tight text-gray-900 dark:text-gray-100 sm:text-5xl md:text-6xl leading-tight">
        Modern tools for the modern enterprise.
    </h1>
    <p class="mx-auto mt-8 max-w-2xl text-base text-gray-500 dark:text-gray-400 sm:text-lg md:text-xl leading-relaxed">
        ACorp helps growing teams ship work faster and keep their customers in the loop &mdash;
        accounts, dashboards, and integrations in one place.
    </p>

    <div class="mx-auto mt-14 flex max-w-md flex-col gap-4 sm:flex-row sm:justify-center sm:gap-6">
        <a href="/Account/Register"
           class="inline-flex items-center justify-center rounded-md border border-transparent bg-indigo-600 px-10 py-4 text-base font-semibold text-white shadow hover:bg-indigo-700 md:text-lg">
            Create your account
        </a>
        <a href="/Account/Login"
           class="inline-flex items-center justify-center rounded-md border border-gray-300 bg-white px-10 py-4 text-base font-semibold text-gray-700 shadow-sm hover:bg-gray-50 dark:bg-gray-800 dark:border-gray-600 dark:text-gray-100 dark:hover:bg-gray-700 md:text-lg">
            Sign in
        </a>
    </div>

    <p class="mt-10 text-sm text-gray-500 dark:text-gray-400">
        Already have a workspace? Sign in to pick up where you left off.
    </p>
</section>

<section class="mx-auto mt-32 max-w-5xl px-4 pb-32 sm:mt-40">
    <div class="grid gap-12 sm:grid-cols-3 sm:gap-10">
        <div class="space-y-4">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Faster onboarding</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
                Provision new teammates in seconds with role-based access and a single sign-on flow.
            </p>
        </div>
        <div class="space-y-4">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Clear ownership</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
                Every workspace tracks who owns what, who reviewed what, and where the trail leads.
            </p>
        </div>
        <div class="space-y-4">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100">Built to integrate</h3>
            <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
                A typed API and webhook surface so the tools you already use stay first-class.
            </p>
        </div>
    </div>
</section>
